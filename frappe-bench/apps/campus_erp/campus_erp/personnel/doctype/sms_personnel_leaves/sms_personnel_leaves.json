{
 "doctype": "DocType",
 "name": "SMS Personnel Leaves",
 "module": "Personnel",
 "custom": 0,
 "istable": 1,
 "is_submittable": 0,
 "autoname": "hash",
 "track_changes": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "leave_type",
   "label": "Leave Type",
   "fieldtype": "Select",
   "options": "Vacation Leave\nSick Leave\nEmergency Leave\nBereavement Leave\nOthers",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "from_date",
   "label": "From Date",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "to_date",
   "label": "To Date",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "half_day",
   "label": "Half Day",
   "fieldtype": "Check",
   "default": "0"
  },
  {
   "fieldname": "reason",
   "label": "Reason",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "other_leave_reason",
   "label": "Other Leave Reason",
   "fieldtype": "Data",
   "depends_on": "eval:doc.leave_type=='Others'"
  },
  {
   "fieldname": "date",
   "label": "Date Applied",
   "fieldtype": "Date",
   "default": "Today"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "options": "Pending\nApproved\nRejected",
   "default": "Pending",
   "in_list_view": 1
  },
  {
   "fieldname": "days_approved",
   "label": "Days Approved",
   "fieldtype": "Float"
  },
  {
   "fieldname": "with_pay",
   "label": "With Pay",
   "fieldtype": "Float"
  },
  {
   "fieldname": "without_pay",
   "label": "Without Pay",
   "fieldtype": "Float"
  },
  {
   "fieldname": "immediate_superior",
   "label": "Immediate Superior",
   "fieldtype": "Data"
  },
  {
   "fieldname": "hrd_head",
   "label": "HRD Head",
   "fieldtype": "Data"
  }
 ],
 "permissions": []
}
